local RunService = game:GetService("RunService")

local spiderWebConnection

TabS:MakeToggle({
    Name = "Anti Webs",
    Default = false,

    Callback = function(state)
        if state then
            -- Remove os TouchInterests que já existem
            local ignore = workspace:FindFirstChild("ignore")
            local spiderWebs = ignore and ignore:FindFirstChild("SpiderWebs")

            if spiderWebs then
                for _, obj in ipairs(spiderWebs:GetDescendants()) do
                    if obj:IsA("MeshPart") and obj.Name == "SpiderWeb" then
                        for _, child in ipairs(obj:GetChildren()) do
                            if child:IsA("TouchTransmitter") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end

            -- Continua removendo automaticamente novos TouchInterests
            spiderWebConnection = RunService.Heartbeat:Connect(function()
                local ignore = workspace:FindFirstChild("ignore")
                local spiderWebs = ignore and ignore:FindFirstChild("SpiderWebs")

                if not spiderWebs then
                    return
                end

                for _, obj in ipairs(spiderWebs:GetDescendants()) do
                    if obj:IsA("MeshPart") and obj.Name == "SpiderWeb" then
                        for _, child in ipairs(obj:GetChildren()) do
                            if child:IsA("TouchTransmitter") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end)

        else
            -- Para completamente quando desativado
            if spiderWebConnection then
                spiderWebConnection:Disconnect()
                spiderWebConnection = nil
            end
        end
    end,
})

TabS:MakeToggle({
    Name = "Auto Bug Spray",
    Default = false,

    Callback = function(state)
        if not state then
            return
        end

        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")

        local player = Players.LocalPlayer
        local Event = ReplicatedStorage.modules.up.Network.RemoteEvent

        task.spawn(function()
            while state do
                local character = player.Character

                if character then
                    local bugSpray = character:FindFirstChild("Bug Spray")

                    if bugSpray and bugSpray:IsA("Tool") then

                        local target

                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("BoolValue")
                                and obj.Name == "IsSpiderCharacter"
                                and obj.Value == true then

                                target = obj.Parent
                                break
                            end
                        end

                        if target then
                            local position

                            if target:IsA("Model") then
                                local root =
                                    target:FindFirstChild("HumanoidRootPart")
                                    or target.PrimaryPart

                                if root then
                                    position = root.Position
                                end

                            elseif target:IsA("BasePart") then
                                position = target.Position
                            end

                            if position then
                                Event:FireServer(
                                    "AttemptUseBugSpray",
                                    533,
                                    position
                                )

                                -- Espera a Tool ser retirada/trocada
                                repeat
                                    task.wait(0.1)
                                    character = player.Character
                                until not state
                                    or not character
                                    or not character:FindFirstChild("Bug Spray")
                            end
                        end
                    end
                end

                task.wait(0.1)
            end
        end)
    end,
})

TabS:MakeToggle({
    Name = "Anti Drag",
    Default = false,

    Callback = function(state)
        if not state then
            return
        end

        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer

            while state do
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.WalkSpeed < 16 then
                    humanoid.WalkSpeed = 22

                    task.wait(3)

                    if humanoid and humanoid.Parent then
                        humanoid.WalkSpeed = 16
                    end
                end

                task.wait(0.1)
            end
        end)
    end,
})

