local RunService = game:GetService("RunService")

local spiderWebConnection

TabS:MakeToggle({
    Name = "Anti Webs",
    Default = false,

    Callback = function(state)
        if state then
            -- Remove os TouchInterests que já existem
            local ignore = workspace:FindFirstChild("ignore")
            local spiderWebs = ignore and ignore:FindFirstChild("SpiderWebs")

            if spiderWebs then
                for _, obj in ipairs(spiderWebs:GetDescendants()) do
                    if obj:IsA("MeshPart") and obj.Name == "SpiderWeb" then
                        for _, child in ipairs(obj:GetChildren()) do
                            if child:IsA("TouchTransmitter") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end

            -- Continua removendo automaticamente novos TouchInterests
            spiderWebConnection = RunService.Heartbeat:Connect(function()
                local ignore = workspace:FindFirstChild("ignore")
                local spiderWebs = ignore and ignore:FindFirstChild("SpiderWebs")

                if not spiderWebs then
                    return
                end

                for _, obj in ipairs(spiderWebs:GetDescendants()) do
                    if obj:IsA("MeshPart") and obj.Name == "SpiderWeb" then
                        for _, child in ipairs(obj:GetChildren()) do
                            if child:IsA("TouchTransmitter") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end)

        else
            -- Para completamente quando desativado
            if spiderWebConnection then
                spiderWebConnection:Disconnect()
                spiderWebConnection = nil
            end
        end
    end,
})

TabS:MakeToggle({
    Name = "Auto Bug Spray",
    Default = false,

    Callback = function(state)
        if not state then
            return
        end

        task.spawn(function()
            while state do
                local player = game:GetService("Players").LocalPlayer
                local character = player.Character

                if character then
                    -- Verifica se o Bug Spray está equipado
                    local bugSpray = character:FindFirstChild("Bug Spray")

                    if bugSpray then
                        -- Procura o personagem/modelo com IsSpiderCharacter
                        local target

                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("BoolValue")
                                and obj.Name == "IsSpiderCharacter"
                                and obj.Value == true then

                                target = obj.Parent
                                break
                            end
                        end

                        if target then
                            local targetPart

                            if target:IsA("Model") then
                                targetPart =
                                    target:FindFirstChild("HumanoidRootPart")
                                    or target.PrimaryPart
                            elseif target:IsA("BasePart") then
                                targetPart = target
                            end

                            if targetPart then
                                local Event = game:GetService("ReplicatedStorage")
                                    .modules.up.Network.RemoteEvent

                                Event:FireServer(
                                    "AttemptUseBugSpray",
                                    285,
                                    targetPart.Position
                                )
                            end
                        end
                    end
                end

                task.wait(0.1)
            end
        end)
    end,
})

TabS:MakeToggle({
    Name = "Anti Drag",
    Default = false,

    Callback = function(state)
        if not state then
            return
        end

        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer

            while state do
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.WalkSpeed < 16 then
                    humanoid.WalkSpeed = 32

                    task.wait(3)

                    if humanoid and humanoid.Parent then
                        humanoid.WalkSpeed = 16
                    end
                end

                task.wait(0.1)
            end
        end)
    end,
})

local TabG = Win:MakeTab({
    Name = "🥀 Give Items 🥀",
    Icon = "rbxassetid://10239810225",
})
TabG:MakeSection("Give Items")

TabG:MakeButton({
    Name = "Give Green Key",
    Callback = function()
        local Players = game:GetService("Players")
        local player = Players.LocalPlayer

        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        local itens = workspace:FindFirstChild("Itens")

        if not itens then
            warn("Pasta Itens não encontrada!")
            return
        end

        -- Procura o Green Key
        local greenKey

        for _, obj in ipairs(itens:GetDescendants()) do
            if obj.Name == "Green Key" then
                greenKey = obj
                break
            end
        end

        if not greenKey then
            warn("Green Key não encontrado!")
            return
        end

        -- Procura a Hitbox
        local hitbox = greenKey:FindFirstChild("Hitbox", true)

        if not hitbox then
            warn("Hitbox não encontrada!")
            return
        end

        -- Procura o ClickDetector dentro da Hitbox
        local clickDetector = hitbox:FindFirstChildOfClass("ClickDetector")

        if not clickDetector then
            warn("ClickDetector não encontrado!")
            return
        end

        -- Salva a posição original
        local oldCFrame = root.CFrame

        -- Teleporta para a Hitbox
        root.CFrame = hitbox.CFrame + Vector3.new(0, 3, 0)

        task.wait(0.2)

        -- Clica
        fireclickdetector(clickDetector)

        task.wait(0.2)

        -- Volta para a posição anterior
        root.CFrame = oldCFrame
    end,
})

