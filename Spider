TabE:MakeToggle({
	Name = "Itens ESP",
	Default = false,
	Callback = function(state)
		local itens = workspace:FindFirstChild("Itens")
		if not itens then return end

		for _, item in ipairs(itens:GetChildren()) do
			if item:IsA("Model") then
				local highlight = item:FindFirstChild("ItemHighlight")

				if state then
					local handle = item:FindFirstChild("Handle", true)

					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "ItemHighlight"
						highlight.Parent = item
					end

					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0

					if handle and handle:IsA("BasePart") then
						highlight.FillColor = handle.Color
						highlight.OutlineColor = handle.Color
					end
				else
					if highlight then
						highlight:Destroy()
					end
				end
			end
		end
	end,
})

