local function UpdateDeviceUI(lastInputType)
    local checkMobile = (lastInputType == Enum.UserInputType.Touch)
    isMobile = checkMobile
    LocalPlayer.DevEnableMouseLock = false 

    if isMobile then
        LockButton.Visible = true
        Crosshair.Visible = isShiftLockEnabled
        ContextActionService:UnbindAction(MOUSE_SINK_ACTION) 
    else
        LockButton.Visible = false
        Crosshair.Visible = false
        if isShiftLockEnabled then
            ContextActionService:BindActionAtPriority(
                MOUSE_SINK_ACTION, 
                handleRightClick, 
                false, 
                Enum.ContextActionPriority.High.Value + 100,
                Enum.UserInputType.MouseButton2
            )
        end
    end
end

