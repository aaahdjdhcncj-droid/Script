-- --- 3. èŽ·å–ç›¸æœº Zoom ---
local function getZoomTarget()
    local success, ZoomController = pcall(function()
        return require(LocalPlayer.PlayerScripts.PlayerModule.CameraModule.ZoomController)
    end)
    if success and ZoomController then
        local upvalues = getupvalues(ZoomController.Update)
        for i, v in pairs(upvalues) do
            if type(v) == "number" then return v end
        end
    end
    return 10
end

