local function GetRoot(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then

        return Object:FindFirstChild("HumanoidRootPart")
            or Object.PrimaryPart
            or Object:FindFirstChildWhichIsA("BasePart", true)

    end

    return nil
end

