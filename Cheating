    if not Phone then
        return nil
    end

    local SurfaceGui =
        Phone:FindFirstChildWhichIsA("SurfaceGui", true)

    if not SurfaceGui then
        return nil
    end

    local Frame =
        SurfaceGui:FindFirstChild("Frame", true)

    if not Frame then
        return nil
    end

    local AnswersText =
        Frame:FindFirstChild("AnswersText", true)

    if AnswersText
        and (
            AnswersText:IsA("TextLabel")
            or AnswersText:IsA("TextButton")
            or AnswersText:IsA("TextBox")
        ) then

        return AnswersText
    end

    return nil
end

