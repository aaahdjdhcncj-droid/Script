local StudentDots = {}

local function CreateStudentDot(Student)

    local Dot = Instance.new("Frame")

    Dot.Name = "StudentDot"
    Dot.Size = UDim2.fromOffset(8, 8)
    Dot.AnchorPoint = Vector2.new(0.5, 0.5)

    -- 🔵 AZUL
    Dot.BackgroundColor3 = Color3.fromRGB(0, 140, 255)

    Dot.BorderSizePixel = 0
    Dot.ZIndex = 8
    Dot.Parent = Radar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Dot

    StudentDots[Student] = Dot

    return Dot
end

local function RemoveStudentDot(Student)

    if StudentDots[Student] then

        StudentDots[Student]:Destroy()
        StudentDots[Student] = nil

    end
end

--========================================================--
-- TEACHER OLHANDO PARA O PLAYER
--========================================================--

local function IsLookingAtPlayer(TeacherRoot, PlayerRoot)

    local Direction = PlayerRoot.Position - TeacherRoot.Position

    if Direction.Magnitude <= 0 then
        return true
    end

    Direction = Direction.Unit

    local Dot = TeacherRoot.CFrame.LookVector:Dot(Direction)

    return Dot > 0.55
end

--========================================================--
-- ATUALIZAR RADAR
--========================================================--

RunService.RenderStepped:Connect(function()

    if not RadarGui.Enabled then
        return
    end

    local Character = Player.Character
    local PlayerRoot = Character and Character:FindFirstChild("HumanoidRootPart")

    if not PlayerRoot then

        TeacherDot.Visible = false
        DistanceText.Text = "Teacher: procurando..."

        return
    end

    --====================================================--
    -- TEACHER
    --====================================================--

    local Teacher = GetTeacher()
    local TeacherRoot = GetRoot(Teacher)

    if TeacherRoot then

        TeacherDot.Visible = true

        local Offset = TeacherRoot.Position - PlayerRoot.Position
        local Distance = Offset.Magnitude

        DistanceText.Text = string.format(
            "Teacher: %.1f studs",
            Distance
        )

        --================================================--
        -- COR DO TEACHER
        --================================================--

        if Distance <= VERY_NEAR_DISTANCE then

            -- 🔴 MUITO PERTO
            TeacherDot.BackgroundColor3 =
                Color3.fromRGB(255, 0, 0)

        elseif Distance <= NEAR_DISTANCE then

            -- 🟡 PERTO
            TeacherDot.BackgroundColor3 =
                Color3.fromRGB(255, 220, 0)

        else

            -- 🟢 LONGE
            TeacherDot.BackgroundColor3 =
                Color3.fromRGB(0, 255, 0)

        end

        --================================================--
        -- POSIÇÃO NO RADAR
        --================================================--

        local RelativeX = Offset.X / RADAR_RANGE
        local RelativeY = Offset.Z / RADAR_RANGE

        RelativeX = math.clamp(RelativeX, -1, 1)
        RelativeY = math.clamp(RelativeY, -1, 1)

        TeacherDot.Position = UDim2.fromScale(
            0.5 + RelativeX * 0.45,
            0.5 + RelativeY * 0.45
        )

        --================================================--
        -- OLHANDO
        --================================================--

        if IsLookingAtPlayer(TeacherRoot, PlayerRoot) then

            LookingText.Text = "👁 OLHANDO\nPARA VOCÊ"

            LookingText.TextColor3 =
                Color3.fromRGB(255, 70, 70)

        else

            LookingText.Text = "✓ NÃO ESTÁ\nOLHANDO"

            LookingText.TextColor3 =
                Color3.fromRGB(80, 255, 80)

        end

    else

        TeacherDot.Visible = false

        DistanceText.Text = "Teacher: não encontrado"

        LookingText.Text = "Teacher\nnão encontrado"

        LookingText.TextColor3 =
            Color3.fromRGB(255, 255, 255)

    end

    --====================================================--
    -- STUDENTS
    --====================================================--

    local CurrentStudents = {}

    for _, Student in ipairs(GetStudents()) do

        CurrentStudents[Student] = true

        local StudentRoot = GetRoot(Student)

        if StudentRoot then

            local Dot = StudentDots[Student]

            if not Dot then
                Dot = CreateStudentDot(Student)
            end

            local Offset =
                StudentRoot.Position - PlayerRoot.Position

            local RelativeX =
                Offset.X / RADAR_RANGE

            local RelativeY =
                Offset.Z / RADAR_RANGE

            RelativeX = math.clamp(RelativeX, -1, 1)
            RelativeY = math.clamp(RelativeY, -1, 1)

            Dot.Position = UDim2.fromScale(
                0.5 + RelativeX * 0.45,
                0.5 + RelativeY * 0.45
            )

            Dot.Visible = true

        end
    end

    --====================================================--
    -- REMOVER STUDENTS QUE SUMIRAM
    --====================================================--

    for Student, Dot in pairs(StudentDots) do

        if not CurrentStudents[Student]
            or not Student.Parent then

            RemoveStudentDot(Student)

        end
    end

end)

