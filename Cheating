local Camera = workspace.CurrentCamera
local Player = game.Players.LocalPlayer

local CameraWasCFrame = nil
local CameraWasType = nil

local function GetTeacher()
    return workspace:FindFirstChild("Teacher", true)
end

local function GetTeacherHead(Teacher)
    if not Teacher then
        return nil
    end

    return Teacher:FindFirstChild("Head", true)
        or Teacher:FindFirstChild("HumanoidRootPart", true)
        or Teacher.PrimaryPart
end

local function StartTeacherCamera()

    local Teacher = GetTeacher()

    if not Teacher then
        warn("Teacher não encontrado!")
        return
    end

    local Head = GetTeacherHead(Teacher)

    if not Head then
        warn("Cabeça do Teacher não encontrada!")
        return
    end

    -- Salva a câmera atual
    CameraWasCFrame = Camera.CFrame
    CameraWasType = Camera.CameraType

    -- Coloca a câmera 3 studs atrás da cabeça
    local CameraPosition =
        Head.Position - Head.CFrame.LookVector * 3

    -- Faz a câmera olhar para a mesma direção que o Teacher
    Camera.CFrame = CFrame.lookAt(
        CameraPosition,
        CameraPosition + Head.CFrame.LookVector
    )

    Camera.CameraType = Enum.CameraType.Scriptable
end

local function StopTeacherCamera()

    if CameraWasCFrame then
        Camera.CFrame = CameraWasCFrame
    end

    if CameraWasType then
        Camera.CameraType = CameraWasType
    else
        Camera.CameraType = Enum.CameraType.Custom
    end

    CameraWasCFrame = nil
    CameraWasType = nil
end

