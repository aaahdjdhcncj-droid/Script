-- Criador dos botões
local botoes = {}

local function criarBotao(nome, texto, ordem, callback)
    local botao = Instance.new("TextButton")
    botao.Name = nome
    botao.Size = UDim2.fromOffset(205, 36)
    botao.Position = UDim2.fromOffset(
        ordem % 2 == 1 and 10 or 224,
        38 + math.floor((ordem - 1) / 2) * 43
    )
    botao.BackgroundColor3 = corOff
    botao.BorderSizePixel = 0
    botao.Text = texto .. " (OFF)"
    botao.TextColor3 = Color3.fromRGB(20, 20, 20)
    botao.TextSize = 13
    botao.Font = Enum.Font.GothamSemibold
    botao.Parent = frame

    local canto = Instance.new("UICorner")
    canto.CornerRadius = UDim.new(0, 6)
    canto.Parent = botao

    botoes[nome] = botao

    botao.MouseButton1Click:Connect(function()
        estado[nome] = not estado[nome]

        botao.BackgroundColor3 = estado[nome] and corOn or corOff
        botao.Text = texto .. (estado[nome] and " (ON)" or " (OFF)")

        if callback then
            callback(estado[nome])
        end
    end)

    return botao
end

-- ESP: remove e recria os destaques de acordo com as opções
local function limparESP()
    for _, objeto in ipairs(workspace:GetDescendants()) do
        if objeto:IsA("Highlight")
            and objeto:GetAttribute("TestToolsESP") then
            objeto:Destroy()
        end
    end
end

local function adicionarHighlight(modelo, nome, cor)
    if not modelo or not modelo:IsA("Model") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = nome
    h:SetAttribute("TestToolsESP", true)
    h.Adornee = modelo
    h.FillColor = cor
    h.OutlineColor = cor
    h.FillTransparency = 0.75
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = workspace
end

local function atualizarESP()
    limparESP()

    if estado.ESPPlayers then
        for _, outro in ipairs(Players:GetPlayers()) do
            if outro ~= player and outro.Character then
                adicionarHighlight(
                    outro.Character,
                    "ESP_Player",
                    Color3.fromRGB(0, 120, 255)
                )
            end
        end
    end

    if estado.ESPBear then
        for _, outro in ipairs(Players:GetPlayers()) do
            local personagem = outro.Character
            local bearNoPlayer = outro:FindFirstChild("IsBear")
            local bearNoCharacter = personagem
                and personagem:FindFirstChild("IsBear")

            if personagem and (bearNoPlayer or bearNoCharacter) then
                adicionarHighlight(
                    personagem,
                    "ESP_Bear",
                    Color3.fromRGB(255, 40, 40)
                )
            end
        end
    end
end

criarBotao("ESPPlayers", "Esp Players", 1, atualizarESP)
criarBotao("ESPBear", "Esp Bear", 2, atualizarESP)

-- ESP de puzzles: etiquetas visíveis através das paredes
local function limparPuzzles()
    for _, objeto in ipairs(workspace:GetDescendants()) do
        if objeto:IsA("BillboardGui")
            and objeto.Name == "TestPuzzleESP" then
            objeto:Destroy()
        end
    end
end

local function criarESPpuzzles()
    limparPuzzles()

    if not estado.ESPPuzzles then
        return
    end

    local bin = workspace:FindFirstChild("PuzzleBin")
    if not bin then
        return
    end

    local nomesPastas = {
        ["Puzzle | Beams"] = true,
        ["Puzzle | Color"] = true,
        ["Puzzle | Cheese"] = true,
    }

    for _, pasta in ipairs(bin:GetChildren()) do
        if nomesPastas[pasta.Name] then
            for _, objeto in ipairs(pasta:GetDescendants()) do
                if objeto:IsA("BasePart") then
                    local etiqueta = Instance.new("BillboardGui")
                    etiqueta.Name = "TestPuzzleESP"
                    etiqueta.Adornee = objeto
                    etiqueta.AlwaysOnTop = true
                    etiqueta.Size = UDim2.fromOffset(120, 25)
                    etiqueta.StudsOffset = Vector3.new(0, 2, 0)
                    etiqueta.Parent = objeto

                    local texto = Instance.new("TextLabel")
                    texto.Size = UDim2.fromScale(1, 1)
                    texto.BackgroundTransparency = 1
                    texto.Text = objeto.Name
                    texto.TextScaled = true
                    texto.Font = Enum.Font.GothamBold
                    texto.TextStrokeTransparency = 0
                    texto.TextColor3 = Color3.fromRGB(255, 0, 255)
                    texto.Parent = etiqueta

                    task.spawn(function()
                        while etiqueta.Parent do
                            for hue = 0, 1, 0.025 do
                                if not etiqueta.Parent then
                                    break
                                end
                                texto.TextColor3 = Color3.fromHSV(hue, 1, 1)
                                task.wait(0.05)
                            end
                        end
                    end)
                end
            end
        end
    end
end

criarBotao("ESPPuzzles", "Esp Puzzles", 3, criarESPpuzzles)

-- Sprint: altera a velocidade do próprio personagem
local velocidadeOriginal

local function atualizarSprint(ativado)
    local personagem = player.Character
    local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if ativado then
        velocidadeOriginal = humanoid.WalkSpeed
        humanoid.WalkSpeed = 32
    else
        humanoid.WalkSpeed = velocidadeOriginal or 16
        velocidadeOriginal = nil
    end
end

criarBotao("Sprint", "Infinite Sprint", 4, atualizarSprint)

player.CharacterAdded:Connect(function(personagem)
    local humanoid = personagem:WaitForChild("Humanoid", 5)
    if humanoid and estado.Sprint then
        velocidadeOriginal = humanoid.WalkSpeed
        humanoid.WalkSpeed = 32
    end

    task.wait(1)
    atualizarESP()
end)

-- Auto Quidz: procura uma peça Quidz dentro de um modelo chamado obby
local function encontrarQuidz()
    local obby = workspace:FindFirstChild("obby", true)
    if not obby then
        return nil
    end

    for _, objeto in ipairs(obby:GetDescendants()) do
        if objeto:IsA("BasePart") and objeto.Name == "Quidz" then
            return objeto
        end
    end

    return nil
end

criarBotao("AutoQuidz", "Auto Quidz", 5, function(ativado)
    if not ativado then
        return
    end

    task.spawn(function()
        while estado.AutoQuidz do
            local personagem = player.Character
            local root = personagem
                and personagem:FindFirstChild("HumanoidRootPart")
            local alvo = encontrarQuidz()

            if root and alvo then
                root.CFrame = alvo.CFrame + Vector3.new(0, 3, 0)
            end

            task.wait(10)
        end
    end)
end)

-- Auto Wires: identifica as peças do puzzle.
-- A interação real depende do sistema de clique/remoto do seu jogo.
criarBotao("AutoWires", "Auto Wires", 6, function(ativado)
    if not ativado then
        return
    end

    local bin = workspace:FindFirstChild("PuzzleBin")
    local beams = bin and bin:FindFirstChild("Puzzle | Beams")
    local interactive = beams and beams:FindFirstChild("Interactive")

    if not interactive then
        warn("Não encontrei Puzzle | Beams > Interactive.")
        return
    end

    local encontradas = 0
    for _, objeto in ipairs(interactive:GetDescendants()) do
        if objeto:IsA("BasePart") and objeto.Name == "PuzzlePart" then
            encontradas += 1
        end
    end

    print("PuzzlePart encontradas:", encontradas)
    warn("Para interagir automaticamente, integre o mecanismo legítimo do puzzle do seu jogo.")
end)

-- Auto Color Code: verifica se os objetos necessários existem.
-- Não simula cliques nem dispara remotos desconhecidos.
criarBotao("AutoColor", "Auto Color Code", 7, function(ativado)
    if not ativado then
        return
    end

    local bin = workspace:FindFirstChild("PuzzleBin")
    local puzzle = bin and bin:FindFirstChild("Puzzle | Color")
    local interactive = puzzle and puzzle:FindFirstChild("Interactive")

    if not interactive then
        warn("Não encontrei Puzzle | Color > Interactive.")
        return
    end

    for i = 1, 4 do
        local painel = interactive:FindFirstChild("Panel" .. i, true)
        print("Panel" .. i, painel and painel:GetFullName() or "não encontrado")
    end

    warn("A sequência de cores precisa ser ligada ao sistema de interação do puzzle do seu jogo.")
end)

