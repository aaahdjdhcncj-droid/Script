-- Reconhecer códigos de cores
local cores = {
    Y = Color3.fromRGB(255, 255, 0),
    R = Color3.fromRGB(255, 0, 0),
    Pu = Color3.fromRGB(128, 0, 128),
    O = Color3.fromRGB(255, 165, 0),
    P = Color3.fromRGB(255, 105, 180),
    G = Color3.fromRGB(0, 255, 0),
    Bl = Color3.fromRGB(0, 0, 0),
    B = Color3.fromRGB(0, 100, 255),
}

local nomesCores = {
    yellow = "Y",
    red = "R",
    purple = "Pu",
    orange = "O",
    pink = "P",
    green = "G",
    black = "Bl",
    blue = "B",
}

local function identificarCor(texto)
    texto = tostring(texto or ""):lower()
    texto = texto:gsub("%s+", "")

    for nome, codigo in pairs(nomesCores) do
        if texto:find(nome, 1, true) then
            return codigo
        end
    end

    if texto:find("pu", 1, true) then
        return "Pu"
    end

    if texto:find("bl", 1, true) then
        return "Bl"
    end

    local primeira = texto:sub(1, 1):upper()
    if cores[primeira] then
        return primeira
    end

    return nil
end

criarBotao("AutoColor", "Auto Color Code", 7, function(ativado)
