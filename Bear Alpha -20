-- Deixa a janela arrastável
local arrastando = false
local inicioArrasto
local posicaoInicial

titulo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true
        inicioArrasto = input.Position
        posicaoInicial = frame.Position
    end
end)

titulo.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = false
    end
end)

RunService.RenderStepped:Connect(function()
    if not arrastando or not inicioArrasto then
        return
    end

    local input = Players.LocalPlayer:GetMouse()
    local mousePos = Vector2.new(input.X, input.Y)
    local delta = mousePos - Vector2.new(inicioArrasto.X, inicioArrasto.Y)

    frame.Position = UDim2.new(
        posicaoInicial.X.Scale,
        posicaoInicial.X.Offset + delta.X,
        posicaoInicial.Y.Scale,
        posicaoInicial.Y.Offset + delta.Y
    )
end)

