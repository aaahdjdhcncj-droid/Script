-- Arrastar a janela com mouse ou toque
local UserInputService = game:GetService("UserInputService")
local arrastando = false
local inicioArrasto
local posicaoInicial
local inputArrasto

titulo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true
        inicioArrasto = input.Position
        posicaoInicial = frame.Position
        inputArrasto = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not arrastando then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - inicioArrasto

        frame.Position = UDim2.new(
            posicaoInicial.X.Scale,
            posicaoInicial.X.Offset + delta.X,
            posicaoInicial.Y.Scale,
            posicaoInicial.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == inputArrasto
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        arrastando = false
        inputArrasto = nil
    end
end)

