-- Botões
local botoes = {}

local function criarBotao(nome, texto, ordem, callback)
    local botao = Instance.new("TextButton")
    botao.Name = nome
    botao.Size = UDim2.fromOffset(205, 36)
    botao.Position = UDim2.fromOffset(
        ordem % 2 == 1 and 10 or 224,
        38 + math.floor((ordem - 1) / 2) * 43
    )
    botao.BackgroundColor3 = corOff
    botao.BorderSizePixel = 0
    botao.Text = texto .. " (OFF)"
    botao.TextColor3 = corTexto
    botao.TextSize = 13
    botao.Font = Enum.Font.GothamSemibold
    botao.Parent = frame

    local canto = Instance.new("UICorner")
    canto.CornerRadius = UDim.new(0, 6)
    canto.Parent = botao

    botoes[nome] = botao

    botao.MouseButton1Click:Connect(function()
        estado[nome] = not estado[nome]
        botao.BackgroundColor3 = estado[nome] and corOn or corOff
        botao.Text = texto .. (estado[nome] and " (ON)" or " (OFF)")

        if callback then
            callback(estado[nome])
        end
    end)

    return botao
end

-- ESP de personagens
local function limparESP()
    for _, objeto in ipairs(workspace:GetDescendants()) do
        if objeto:IsA("Highlight")
            and objeto:GetAttribute("TestToolsESP") then
            objeto:Destroy()
        end
    end
end

local function adicionarHighlight(modelo, nome, cor)
    if not modelo or not modelo:IsA("Model") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = nome
    h:SetAttribute("TestToolsESP", true)
    h.Adornee = modelo
    h.FillColor = cor
    h.OutlineColor = cor
    h.FillTransparency = 0.65
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = workspace
end

local function temIsBear(personagem)
    if not personagem then
        return false
    end

    local valor = personagem:FindFirstChild("IsBear", true)
    return valor ~= nil and valor:IsA("StringValue")
end

local function atualizarESP()
    limparESP()

    for _, outro in ipairs(Players:GetPlayers()) do
        local personagem = outro.Character

        if personagem then
            if estado.ESPPlayers and outro ~= player then
                adicionarHighlight(
                    personagem,
                    "ESP_Player",
                    Color3.fromRGB(0, 120, 255)
                )
            end

            if estado.ESPBear and temIsBear(personagem) then
                adicionarHighlight(
                    personagem,
                    "ESP_Bear",
                    Color3.fromRGB(255, 40, 40)
                )
            end
        end
    end
end

criarBotao("ESPPlayers", "Esp Players", 1, atualizarESP)
criarBotao("ESPBear", "Esp Bear", 2, atualizarESP)

-- ESP Puzzles: uma etiqueta pequena por peça relevante
local function limparPuzzles()
    for _, objeto in ipairs(workspace:GetDescendants()) do
        if objeto:IsA("BillboardGui")
            and objeto.Name == "TestPuzzleESP" then
            objeto:Destroy()
        end
    end
end

local function criarESPpuzzles()
    limparPuzzles()

    if not estado.ESPPuzzles then
        return
    end

    local bin = workspace:FindFirstChild("PuzzleBin")
    if not bin then
        warn("PuzzleBin não foi encontrado.")
        return
    end

    local nomesPastas = {
        ["Puzzle | Beams"] = true,
        ["Puzzle | Color"] = true,
        ["Puzzle | Cheese"] = true,
    }

    for nomePasta in pairs(nomesPastas) do
        local pasta = bin:FindFirstChild(nomePasta)

        if pasta then
            local interactive = pasta:FindFirstChild("Interactive")
            local origem = interactive or pasta

            for _, objeto in ipairs(origem:GetDescendants()) do
                if objeto:IsA("BasePart") then
                    local etiqueta = Instance.new("BillboardGui")
                    etiqueta.Name = "TestPuzzleESP"
                    etiqueta.Adornee = objeto
                    etiqueta.AlwaysOnTop = true
                    etiqueta.Size = UDim2.fromOffset(65, 14)
                    etiqueta.StudsOffset = Vector3.new(0, 1.5, 0)
                    etiqueta.MaxDistance = 250
                    etiqueta.Parent = objeto

                    local texto = Instance.new("TextLabel")
                    texto.Size = UDim2.fromScale(1, 1)
                    texto.BackgroundTransparency = 1
                    texto.Text = objeto.Name
                    texto.TextScaled = false
                    texto.TextSize = 10
                    texto.Font = Enum.Font.GothamBold
                    texto.TextStrokeTransparency = 0
                    texto.TextColor3 = Color3.fromRGB(255, 0, 255)
                    texto.Parent = etiqueta
                end
            end
        end
    end
end

criarBotao("ESPPuzzles", "Esp Puzzles", 3, criarESPpuzzles)

-- Infinite Sprint
local velocidadeOriginal

local function atualizarSprint(ativado)
    local personagem = player.Character
    local humanoid = personagem
        and personagem:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if ativado then
        velocidadeOriginal = humanoid.WalkSpeed
        humanoid.WalkSpeed = 32
    else
        humanoid.WalkSpeed = velocidadeOriginal or 16
        velocidadeOriginal = nil
    end
end

criarBotao("Sprint", "Infinite Sprint", 4, atualizarSprint)

-- Localiza Obby/obby e Quidz/quidz
local function encontrarQuidz()
    local obby

    for _, objeto in ipairs(workspace:GetDescendants()) do
        if objeto:IsA("Model")
            and string.lower(objeto.Name) == "obby" then
            obby = objeto
            break
        end
    end

    if not obby then
        return nil
    end

    for _, objeto in ipairs(obby:GetDescendants()) do
        if objeto:IsA("BasePart")
            and string.lower(objeto.Name) == "quidz" then
            return objeto
        end
    end

    return nil
end

criarBotao("AutoQuidz", "Auto Quidz", 5, function(ativado)
    if not ativado then
        return
    end

    task.spawn(function()
        while estado.AutoQuidz do
            local personagem = player.Character
            local root = personagem
                and personagem:FindFirstChild("HumanoidRootPart")
            local alvo = encontrarQuidz()

            if root and alvo then
                -- Teleporte de teste no próprio jogo.
                root.CFrame = alvo.CFrame + Vector3.new(0, 3, 0)
            end

            task.wait(10)
        end
    end)
end)

-- Auto Wires: localizar peças e validar a estrutura
local function encontrarInteractive(nomePuzzle)
    local bin = workspace:FindFirstChild("PuzzleBin")
    local puzzle = bin and bin:FindFirstChild(nomePuzzle)
    return puzzle and puzzle:FindFirstChild("Interactive")
end

criarBotao("AutoWires", "Auto Wires", 6, function(ativado)
    if not ativado then
        return
    end

    local interactive = encontrarInteractive("Puzzle | Beams")
    if not interactive then
        warn("Não encontrei PuzzleBin > Puzzle | Beams > Interactive.")
        return
    end

    local quantidade = 0

    for _, objeto in ipairs(interactive:GetDescendants()) do
        if objeto:IsA("BasePart") and objeto.Name == "PuzzlePart" then
            quantidade += 1
        end
    end

    print("PuzzlePart encontradas:", quantidade)
    print("Ligue a interação ao mecanismo do puzzle do seu próprio jogo.")
end)

-- Auto Color Code: ler pistas R, Y, Pu, O, P, G, Bl e B
local cores = {
    Y = Color3.fromRGB(255, 255, 0),       -- Yellow
    R = Color3.fromRGB(255, 0, 0),         -- Red
    Pu = Color3.fromRGB(128, 0, 128),      -- Purple
    O = Color3.fromRGB(255, 165, 0),       -- Orange
    P = Color3.fromRGB(255, 105, 180),     -- Pink
    G = Color3.fromRGB(0, 255, 0),         -- Green
    Bl = Color3.fromRGB(0, 0, 0),          -- Black
    B = Color3.fromRGB(0, 100, 255),       -- Blue
}

local nomesCores = {
    yellow = "Y",
    red = "R",
    purple = "Pu",
    orange = "O",
    pink = "P",
    green = "G",
    black = "Bl",
    blue = "B",
}

local function identificarCor(texto)
    texto = string.lower(tostring(texto or ""))
    texto = string.gsub(texto, "%s+", "")

    -- Tenta nomes completos antes das abreviações.
    for nome, codigo in pairs(nomesCores) do
        if string.find(texto, nome, 1, true) then
            return codigo
        end
    end

    -- As abreviações de duas letras são verificadas primeiro.
    local codigo = string.match(texto, "pu")
        or string.match(texto, "bl")

    if codigo then
        return codigo == "pu" and "Pu" or "Bl"
    end

    local primeira = string.sub(texto, 1, 1):upper()
    if cores[primeira] then
        return primeira
    end

    return nil
end

local function lerTextoDescendente(objeto)
    for _, item in ipairs(objeto:GetDescendants()) do
        if item:IsA("TextLabel") or item:IsA("TextButton") then
            if item.Text ~= "" then
                return item.Text
            end
        end
    end

    return objeto.Name
end

criarBotao("AutoColor", "Auto Color Code", 7, function(ativado)
    if not ativado then
        return
    end

    local interactive = encontrarInteractive("Puzzle | Color")
    if not interactive then
        warn("Não encontrei PuzzleBin > Puzzle | Color > Interactive.")
        return
    end

    for i = 1, 4 do
        local painel = interactive:FindFirstChild("Panel" .. i, true)

        if painel and painel:IsA("BasePart") then
            local pista = lerTextoDescendente(painel)
            local codigo = identificarCor(pista)

            print(
                "Panel" .. i,
                "pista:",
                pista,
                "código reconhecido:",
                codigo or "não identificado"
            )
        else
            warn("Panel" .. i .. " não foi encontrado.")
        end
    end

    print("Cores disponíveis:", "Y, R, Pu, O, P, G, Bl, B")
    warn("A leitura da pista precisa ser associada ao objeto Clue/Note real do seu puzzle.")
    warn("A interação automática deve usar o sistema de validação do seu próprio jogo.")
end)

