-- Get All Skin: cria valores SOMENTE no cliente, para teste visual.
local skinButton = Instance.new("TextButton")
skinButton.Name = "GetAllSkin"
skinButton.Size = UDim2.fromOffset(205, 36)
skinButton.Position = UDim2.fromOffset(10, 210)
skinButton.BackgroundColor3 = Color3.fromRGB(145, 145, 145)
skinButton.BorderSizePixel = 0
skinButton.Text = "Get All Skin (Inject)"
skinButton.TextColor3 = Color3.fromRGB(20, 20, 20)
skinButton.TextSize = 13
skinButton.Font = Enum.Font.GothamSemibold
skinButton.Parent = frame

local skinCorner = Instance.new("UICorner")
skinCorner.CornerRadius = UDim.new(0, 6)
skinCorner.Parent = skinButton

skinButton.MouseButton1Click:Connect(function()
    skinButton.Text = "Inject..."
    skinButton.BackgroundColor3 = Color3.fromRGB(255, 220, 0)

    task.spawn(function()
        local sucesso, erro = pcall(function()
            local values = player:FindFirstChild("PlayerValues")
            local inventory = values and values:FindFirstChild("Inventory")
            local content = ReplicatedStorage:FindFirstChild("GameContent")

            if not inventory or not content then
                error("PlayerValues.Inventory ou ReplicatedStorage.GameContent não encontrado.")
            end

            task.wait(2)

            for _, categoria in ipairs(content:GetChildren()) do
                if categoria:FindFirstChild("CategoryData") then
                    local pastaCategoria = inventory:FindFirstChild(categoria.Name)

                    if not pastaCategoria then
                        pastaCategoria = Instance.new("Folder")
                        pastaCategoria.Name = categoria.Name
                        pastaCategoria.Parent = inventory
                    end

                    for _, item in ipairs(categoria:GetChildren()) do
                        if item.Name ~= "CategoryData"
                            and not pastaCategoria:FindFirstChild(item.Name) then
                            local valor = Instance.new("StringValue")
                            valor.Name = item.Name
                            valor.Value = item.Name
                            valor.Parent = pastaCategoria
                        end
                    end
                end
            end
        end)

        if not sucesso then
            warn("Get All Skin:", erro)
            skinButton.Text = "Erro: confira Output"
            skinButton.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
            task.wait(2)
        else
            skinButton.Text = "Concluído (local)"
            skinButton.BackgroundColor3 = Color3.fromRGB(255, 220, 0)
            task.wait(2)
        end

        skinButton.Text = "Get All Skin (Inject)"
        skinButton.BackgroundColor3 = corOff
    end)
end)

